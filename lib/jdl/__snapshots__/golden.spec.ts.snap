exports[`jdl - golden lib/jdl/core/__test-support__/files/complex_jdl.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities Department, JobHistory, Job, Employee, Location, Task, Country, Region
}

entity Department {
  guid UUID required
  name String required unique
  description TextBlob
  advertisement Blob
  logo ImageBlob
}
/**
 * JobHistory comment.
 */
entity JobHistory {
  startDate ZonedDateTime
  endDate ZonedDateTime
  language Language
}
entity Job {
  jobTitle String minlength(5) maxlength(25)
  jobType JobType
  minSalary Long
  maxSalary Long
}
/**
 * The Employee entity.\\nSecond line in documentation.
 */
entity Employee {
  /**
   * The firstname attribute.
   */
  firstName String
  lastName String
  email String
  phoneNumber String
  hireDate ZonedDateTime
  salary Long
  commissionPct Long
}
entity Location {
  streetAddress String
  postalCode String
  city String
  stateProvince String
}
entity Task {
  title String
  description String
}
entity Country {
  countryName String
}
entity Region {
  regionName String
}

enum Language {
  FRENCH,
  ENGLISH,
  SPANISH
}
enum JobType {
  TYPE1,
  TYPE2
}

relationship OneToOne {
  Department{location} to Location
  JobHistory{department} to Department
  JobHistory{job} to Job
  JobHistory{employee} to Employee
  Location{country} to Country
  Country{region} to Region
}
relationship OneToMany {
  /**
   * A relationship
   */
  Department{employee} to
  /**
   * Another side of the same relationship
   */
  Employee{department}
  Employee{job} to Job{employee}
}
relationship ManyToOne {
  Employee{user(login)} to User with builtInEntity
  Employee{manager} to Employee
}
relationship ManyToMany {
  Job{chore(title)} to Task{job}
}

microservice Department, JobHistory, Job, Employee, Location, Task, Country, Region with mymicroservice
paginate JobHistory, Employee with infinite-scroll
paginate Job with pagination
dto Employee with mapstruct
service Employee with serviceClass
search Employee with elasticsearch
",
}
`;

