exports[`jdl - golden lib/jdl/core/printing/__test-support__/entities.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities Product, Empty, Annotated
}

/**
 * An entity.
 */
@ChangelogDate("20200101000000")
@Paginate("pagination")
@Skip
entity Product (product_table) {
  /**
   * First line.\\nSecond line.
   */
  @Id
  @Custom(1)
  @Flag(false)
  name String required unique minlength(2) maxlength(42) pattern(/^[a-z\\' ]+$/)
  price BigDecimal min(0.5)
  quantity Integer min(0) max(100)
  picture ImageBlob maxbytes(1000)
}
entity Empty
@Unary
entity Annotated
",
}
`;

