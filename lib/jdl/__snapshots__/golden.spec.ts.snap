exports[`jdl - golden lib/jdl/core/printing/__test-support__/relationships.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities A, B, C
}

entity A
entity B
entity C

relationship OneToOne {
  A{b} to B{a}
  /**
   * The side of A.
   */
  A{c(name) required} to C{a}
  C{a} to
  /**
   * The side of A.
   */
  A{c(name) required}
}
relationship OneToMany {
  A{b} to B{a}
}
relationship ManyToOne {
  @Other(x) A{user(login)} to User with builtInEntity
  /**
   * Commented after an annotation.
   */
  B{c} to @Opt C{b}
}
relationship ManyToMany {
  A{tag required} to B{a}
}
",
}
`;
