exports[`jdl - golden lib/jdl/core/__test-support__/files/big_sample.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities Department, JobHistory, Job, Employee, Location, Task, Country, Region
}

entity Department {
  name String required
  description TextBlob
  advertisement Blob
  logo ImageBlob
}
/**
 * JobHistory comment.
 */
entity JobHistory {
  startDate ZonedDateTime
  endDate ZonedDateTime
  language Language
  positionDuration Duration
}
entity Job {
  title String minlength(5) maxlength(25)
  type JobType
  minSalary Long
  maxSalary Long
}
/**
 * The Employee entity.\\nSecond line in documentation.
 */
entity Employee {
  /**
   * The firstname attribute.
   */
  firstName String
  lastName String
  email String
  phoneNumber String
  hireDate ZonedDateTime
  salary Long
  commissionPct Long
}
entity Location {
  streetAddress String
  postalCode String
  city String
  stateProvince String
}
entity Task {
  title String
  description String
}
entity Country {
  name String
}
entity Region {
  name String
}

enum Language {
  FRENCH,
  ENGLISH,
  SPANISH
}
enum JobType {
  BOSS,
  SLAVE
}

relationship OneToOne {
  @Id(42) Department{location} to @Id Location{department}
}
relationship OneToMany {
  /**
   * A relationship
   */
  Department{employee} to
  /**
   * Another side of the same relationship,
   */
  Employee{department}
  Employee{job} to Job{emp(employee)}
  Location{country} to Country
  Country{area(region)} to Region
}
relationship ManyToOne {
  Employee{user(login)} to User with builtInEntity
  Employee{manager(lastName)} to Employee
}
relationship ManyToMany {
  JobHistory{department} to Department{jobHistory}
  JobHistory{job} to Job{history}
  JobHistory{emp(employee)} to Employee{jobHistory}
  Job{chore(title)} to Task{linkedJob(jobTitle)}
}

microservice Department, JobHistory, Job, Employee, Location, Task, Country, Region with mymicroservice
embedded Department
paginate JobHistory, Employee with infinite-scroll
paginate Job with pagination
readOnly JobHistory
dto Employee with mapstruct
service Employee with serviceClass
search Employee with elasticsearch
",
}
`;

