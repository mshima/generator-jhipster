exports[`jdl - golden lib/jdl/core/__test-support__/files/annotations.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities A, B, C
}

@Service("serviceClass")
@Dto("mapstruct")
@SkipClient
@MyCustomUnaryOption
@MyCustomBinaryOption("customValue")
entity A {
  @Id
  @MultiValue(value1,value2,value3)
  name String
  noAnnotation String
}
@Pagination("pagination")
@Dto("mapstruct")
@Service("serviceClass")
@MyCustomUnaryOption
entity B
@SkipClient
@Filter
@Pagination("pagination")
@MyCustomBinaryOption("customValue2")
entity C

relationship OneToMany {
  @AnnotationOnDestination A{b required} to @AnnotationOnSource(toto) B{a}
}
",
}
`;

