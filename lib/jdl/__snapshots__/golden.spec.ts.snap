exports[`jdl - golden .blueprint/generate-sample/templates/test-integration/samples/jdl-entities/custom-domain.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities CustomPackageParent, CustomPackageChild
}

@ChangelogDate(20200804035400)
@EntityPackage("app.custom")
entity CustomPackageParent {
  parentName String
}
@ChangelogDate(20200804035401)
@EntityPackage("app.child")
entity CustomPackageChild {
  childName String
}

relationship OneToMany {
  CustomPackageParent{customPackageChild} to CustomPackageChild{customPackageParent}
}
relationship ManyToOne {
  CustomPackageChild{user} to User with builtInEntity
}

dto CustomPackageParent, CustomPackageChild with mapstruct
service CustomPackageParent, CustomPackageChild with serviceClass
",
}
`;

