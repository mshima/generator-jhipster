exports[`jdl - golden lib/jdl/core/__test-support__/files/realistic_sample.jdl should match the jdl exported from each application 1`] = `
{
  "invoice": "application {
  config {
    applicationType microservice
    authenticationType jwt
    baseName invoice
    buildTool gradle
    packageName com.jhipster.demo.invoice
    prodDatabaseType mysql
    serverPort 8082
    serviceDiscoveryType no
  }

  entities Invoice, Shipment
}

entity Invoice {
  code String required
  date Instant required
  details String
  status InvoiceStatus required
  paymentMethod PaymentMethod required
  paymentDate Instant required
  paymentAmount BigDecimal required
}
entity Shipment {
  trackingCode String
  date Instant required
  details String
  shippingDuration Duration
}

enum InvoiceStatus {
  PAID,
  ISSUED,
  CANCELLED
}
enum PaymentMethod {
  CREDIT_CARD,
  CASH_ON_DELIVERY,
  PAYPAL
}

relationship OneToMany {
  Invoice{shipment} to Shipment{invoice(code) required}
}

paginate Invoice, Shipment with pagination
service Invoice, Shipment with serviceClass
microservice Invoice, Shipment with invoice
",
  "notification": "application {
  config {
    applicationType microservice
    authenticationType jwt
    baseName notification
    buildTool gradle
    cacheProvider no
    databaseType mongodb
    enableHibernateCache false
    packageName com.jhipster.demo.notification
    serverPort 8083
    serviceDiscoveryType no
  }

  entities Notification
}

entity Notification {
  date Instant required
  details String
  sentDate Instant required
  format NotificationType required
  userId Long required
  productId Long required
}

enum NotificationType {
  EMAIL,
  SMS,
  PARCEL
}

microservice Notification with notification
",
  "product": "application {
  config {
    applicationType microservice
    authenticationType jwt
    baseName product
    buildTool gradle
    cacheProvider hazelcast
    packageName com.jhipster.demo.product
    prodDatabaseType mysql
    serverPort 8081
    serviceDiscoveryType no
  }

  entities Product, ProductCategory, ProductOrder, OrderItem
}

entity Product {
  name String required
  description String
  price BigDecimal required min(0)
  productSize Size required
  image ImageBlob
}
entity ProductCategory {
  name String required
  description String
}
entity ProductOrder {
  placedDate Instant required
  status OrderStatus required
  code String required
  invoiceId Long
  customer String required
}
entity OrderItem {
  quantity Integer required min(0)
  totalPrice BigDecimal required min(0)
  status OrderItemStatus required
}

enum Size {
  S,
  M,
  L,
  XL,
  XXL
}
enum OrderStatus {
  COMPLETED,
  PENDING,
  CANCELLED
}
enum OrderItemStatus {
  AVAILABLE,
  OUT_OF_STOCK,
  BACK_ORDER
}

relationship OneToMany {
  ProductCategory{product} to Product{productCategory(name)}
  ProductOrder{orderItem} to OrderItem{order(code) required}
}
relationship ManyToOne {
  OrderItem{product(name) required} to Product
}

paginate Product, ProductOrder, OrderItem with pagination
service Product, ProductCategory, ProductOrder, OrderItem with serviceClass
microservice Product, ProductCategory, ProductOrder, OrderItem with product
",
  "store": "application {
  config {
    applicationType gateway
    authenticationType jwt
    baseName store
    buildTool gradle
    cacheProvider hazelcast
    clientFramework react
    packageName com.jhipster.demo.store
    prodDatabaseType mysql
    serviceDiscoveryType no
    testFrameworks [cypress]
  }

  entities Customer, Product, ProductCategory, ProductOrder, OrderItem, Invoice, Shipment, Notification
}

entity Customer {
  firstName String required
  lastName String required
  gender Gender required
  email String required pattern(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/)
  phone String required
  addressLine1 String required
  addressLine2 String
  city String required
  country String required
}
entity Product {
  name String required
  description String
  price BigDecimal required min(0)
  productSize Size required
  image ImageBlob
}
entity ProductCategory {
  name String required
  description String
}
entity ProductOrder {
  placedDate Instant required
  status OrderStatus required
  code String required
  invoiceId Long
  customer String required
}
entity OrderItem {
  quantity Integer required min(0)
  totalPrice BigDecimal required min(0)
  status OrderItemStatus required
}
entity Invoice {
  code String required
  date Instant required
  details String
  status InvoiceStatus required
  paymentMethod PaymentMethod required
  paymentDate Instant required
  paymentAmount BigDecimal required
}
entity Shipment {
  trackingCode String
  date Instant required
  details String
  shippingDuration Duration
}
entity Notification {
  date Instant required
  details String
  sentDate Instant required
  format NotificationType required
  userId Long required
  productId Long required
}

enum Gender {
  MALE,
  FEMALE,
  OTHER
}
enum Size {
  S,
  M,
  L,
  XL,
  XXL
}
enum OrderStatus {
  COMPLETED,
  PENDING,
  CANCELLED
}
enum OrderItemStatus {
  AVAILABLE,
  OUT_OF_STOCK,
  BACK_ORDER
}
enum InvoiceStatus {
  PAID,
  ISSUED,
  CANCELLED
}
enum PaymentMethod {
  CREDIT_CARD,
  CASH_ON_DELIVERY,
  PAYPAL
}
enum NotificationType {
  EMAIL,
  SMS,
  PARCEL
}

relationship OneToOne {
  Customer{user(login) required} to User with builtInEntity
}
relationship OneToMany {
  ProductCategory{product} to Product{productCategory(name)}
  ProductOrder{orderItem} to OrderItem{order(code) required}
  Invoice{shipment} to Shipment{invoice(code) required}
}
relationship ManyToOne {
  OrderItem{product(name) required} to Product
}

paginate Customer, Product, ProductOrder, OrderItem, Invoice, Shipment with pagination
service Customer, Product, ProductCategory, ProductOrder, OrderItem, Invoice, Shipment with serviceClass
microservice Product, ProductCategory, ProductOrder, OrderItem with product
microservice Invoice, Shipment with invoice
microservice Notification with notification
",
}
`;

