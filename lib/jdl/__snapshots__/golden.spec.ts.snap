exports[`jdl - golden lib/jdl/core/__test-support__/files/complex_jdl_2.jdl should match the jdl exported from each application 1`] = `
{
  "jhipster": "application {
  config {
    applicationType monolith
    baseName jhipster
  }

  entities A, B, C, D, E, F, G
}

entity A
entity B
entity C {
  name String required
}
entity D {
  name String required minlength(1) maxlength(42)
  count Integer
}
entity E
/**
 * My comment for F.
 */
entity F {
  /**
   * My comment for name of F.
   */
  name String
  count Integer
  /**
   * My comment for flag of F.
   */
  flag Boolean required
}
entity G {
  /**
   * xyz
   */
  name String required
  /**
   * def
   */
  count Integer
}

dto A, B, C, D, E, F with mapstruct
paginate A, B, C, D, E, F with infinite-scroll
paginate G with pagination
service A, B, C, D, E, F with serviceClass
service G with serviceImpl
",
}
`;

