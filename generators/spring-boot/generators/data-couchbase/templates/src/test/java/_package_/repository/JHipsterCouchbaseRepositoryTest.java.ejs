package <%- packageName %>.repository;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.springframework.data.annotation.Id;
import org.springframework.data.annotation.Transient;
import org.springframework.data.core.PropertyReferenceException;
import org.springframework.data.couchbase.core.mapping.CouchbaseMappingContext;
import org.springframework.data.couchbase.core.mapping.Field;
import org.springframework.data.domain.Sort;

class JHipsterCouchbaseRepositoryTest {

    private final CouchbaseMappingContext mappingContext = new CouchbaseMappingContext();

    @SuppressWarnings("unused")
    private static class Person {

        @Id
        private String id;

        private String name;

        @Field("nick")
        private String nickName;

        private Address address;

        @Transient
        private String notStored;
    }

    @SuppressWarnings("unused")
    private static class Address {

        private String city;
    }

    private Sort sortByProperties(Sort sort, String prefix) {
        return JHipsterCouchbaseRepository.sortByProperties(mappingContext, Person.class, sort, prefix);
    }

    @Test
    void shouldOrderByThePropertiesAsQuotedFields() {
        Sort sort = sortByProperties(Sort.by(Sort.Order.asc("name"), Sort.Order.desc("nickName"), Sort.Order.asc("address.city")), "b");

        assertThat(sort.stream().map(order -> order.getProperty() + " " + order.getDirection()))
            .containsExactly("b.`name` ASC", "b.`nick` DESC", "b.`address`.`city` ASC");
    }

    @Test
    void shouldOrderByTheIdOfTheDocument() {
        assertThat(sortByProperties(Sort.by("id"), "b").stream().map(Sort.Order::getProperty)).containsExactly("meta(b).id");
        assertThat(sortByProperties(Sort.by("id"), "").stream().map(Sort.Order::getProperty)).containsExactly("meta().id");
    }

    @Test
    void shouldNotPrefixWithoutAlias() {
        assertThat(sortByProperties(Sort.by("name"), "").stream().map(Sort.Order::getProperty)).containsExactly("`name`");
    }

    @ParameterizedTest
    @ValueSource(strings = { "doesNotExist", "address.doesNotExist", "name.doesNotExist", "notStored" })
    void shouldRejectWhatIsNotAPropertyOfTheEntity(String property) {
        assertThatThrownBy(() -> sortByProperties(Sort.by(property), "b")).isInstanceOf(PropertyReferenceException.class);
    }
}
