package <%- packageName %>.config;

import org.springframework.beans.BeanUtils;
import org.springframework.data.convert.PropertyValueConverter;
import org.springframework.data.couchbase.core.convert.CouchbaseConversionContext;
import org.springframework.data.couchbase.core.convert.ConverterHasNoConversion;
import org.springframework.data.couchbase.core.mapping.CouchbasePersistentEntity;
import org.springframework.data.couchbase.core.mapping.CouchbasePersistentProperty;
import org.springframework.data.mapping.context.MappingContext;

/**
 * Stores the entity of a relationship as its key, and reads the key as an entity with its id.
 * The queries with a join read the entity itself, which is left to Spring Data.
 */
public class EntityKeyConverter implements PropertyValueConverter<Object, Object, CouchbaseConversionContext> {

    @Override
    public Object read(Object value, CouchbaseConversionContext context) {
        if (!(value instanceof String key)) {
            throw new ConverterHasNoConversion();
        }
        return reference(context.getConverter().getMappingContext(), context.getProperty().getType(), key);
    }

    @Override
    public Object write(Object value, CouchbaseConversionContext context) {
        return key(context.getConverter().getMappingContext(), value);
    }

    static Object key(MappingContext<? extends CouchbasePersistentEntity<?>, CouchbasePersistentProperty> mappingContext, Object entity) {
        return mappingContext.getRequiredPersistentEntity(entity.getClass()).getIdentifierAccessor(entity).getIdentifier();
    }

    static Object reference(
        MappingContext<? extends CouchbasePersistentEntity<?>, CouchbasePersistentProperty> mappingContext,
        Class<?> type,
        Object key
    ) {
        CouchbasePersistentEntity<?> entity = mappingContext.getRequiredPersistentEntity(type);
        Object reference = BeanUtils.instantiateClass(entity.getType());
        entity.getPropertyAccessor(reference).setProperty(entity.getRequiredIdProperty(), key);
        return reference;
    }
}
