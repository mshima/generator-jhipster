package <%- packageName %>.config;

import java.util.Collection;
import java.util.LinkedHashSet;
import java.util.Set;
import org.springframework.data.convert.PropertyValueConverter;
import org.springframework.data.couchbase.core.convert.CouchbaseConversionContext;
import org.springframework.data.couchbase.core.convert.ConverterHasNoConversion;
import org.springframework.data.couchbase.core.mapping.CouchbaseList;

/**
 * Stores the entities of a relationship as a list of their keys, and reads the keys as entities with their ids.
 * The queries with a join read the entities themselves, which is left to Spring Data.
 * It is given the collection of entities by {@link EntityReferencesMappingCouchbaseConverter}.
 */
public class EntityKeysConverter implements PropertyValueConverter<Object, Object, CouchbaseConversionContext> {

    @Override
    public Object read(Object value, CouchbaseConversionContext context) {
        if (!(value instanceof CouchbaseList keys)) {
            throw new ConverterHasNoConversion();
        }
        Class<?> type = context.getProperty().getTypeInformation().getRequiredActualType().getType();
        Set<Object> references = new LinkedHashSet<>();
        for (int i = 0; i < keys.size(); i++) {
            if (!(keys.get(i) instanceof String key)) {
                throw new ConverterHasNoConversion();
            }
            references.add(EntityKeyConverter.reference(context.getConverter().getMappingContext(), type, key));
        }
        return references;
    }

    @Override
    public Object write(Object value, CouchbaseConversionContext context) {
        CouchbaseList keys = new CouchbaseList();
        for (Object entity : (Collection<?>) value) {
            keys.put(EntityKeyConverter.key(context.getConverter().getMappingContext(), entity));
        }
        return keys;
    }
}
