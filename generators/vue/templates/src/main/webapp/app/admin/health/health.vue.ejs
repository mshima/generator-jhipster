<template>
  <div>
    <h2>
      <span id="health-page-heading" data-cy="healthPageHeading">{{ t$('health.title') }}</span>
      <button class="btn btn-primary float-end" @click="refresh()" :disabled="updatingHealth">
        <font-awesome-icon icon="sync"></font-awesome-icon> <span>{{ t$('health[\'refresh.button\']') }}</span>
      </button>
    </h2>
    <div class="table-responsive">
      <table id="healthCheck" class="table table-striped" aria-describedby="health-page-heading">
        <thead>
          <tr>
            <th scope="col">{{ t$('health.table.service') }}</th>
            <th class="text-center" scope="col">{{ t$('health.table.status') }}</th>
            <th class="text-center" scope="col">{{ t$('health.details.details') }}</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="health of healthData" :key="health.name">
            <td><%- enableTranslation ? '<span />{{ t$(\'health.indicator.\' + health.baseName) }}' : '<span class="text-capitalize">{{ health.baseName }}</span>' %> {{ health.subSystemName }}</td>
            <td class="text-center">
              <span class="badge" :class="getBadgeClass(health.status)"><%- enableTranslation ? '{{ t$(\'health.status.\' + health.status) }}' : '{{ health.status }}' %></span>
            </td>
            <td class="text-center">
              <a class="hand" @click="showHealth(health)" v-if="health.details || health.error">
                <font-awesome-icon icon="eye"></font-awesome-icon>
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <b-modal ref="healthModal" ok-only>
      <template #title>
        <h4 v-if="currentHealth" class="modal-title" id="showHealthLabel">
<%_ if (enableTranslation) { _%>
          <span>{{ t$('health.indicator.' + currentHealth.baseName) }}</span>
<%_ } else { _%>
          <span class="text-capitalize">{{ currentHealth.baseName }}</span>
<%_ } _%>
          {{ currentHealth.subSystemName }}
        </h4>
      </template>
      <HealthModal :current-health="currentHealth"></HealthModal>
    </b-modal>
  </div>
</template>

<script setup lang="ts">
import { type Ref, inject, onMounted, ref } from 'vue';
<%_ if (enableTranslation) { _%>
import { useI18n } from 'vue-i18n';
<%_ } _%>

import { type HealthIndicator, toHealthModel } from '@/shared/jhipster/health';

import HealthModal from './health-modal.vue';
import HealthService, { healthServiceKey } from './health.service';

defineOptions({ name: '<%- jhiPrefixCapitalized %>Health' });

const healthService = inject(healthServiceKey, () => new HealthService(), true);
<%_ if (enableTranslation) { _%>
const { t: t$ } = useI18n();
<%_ } _%>

const healthData: Ref<HealthIndicator[] | null> = ref(null);
const currentHealth: Ref<HealthIndicator | null> = ref(null);
const updatingHealth = ref(false);

const healthModal = ref<{ show: () => void } | null>(null);

const getBadgeClass = (statusState: unknown): string => (statusState === 'UP' ? 'bg-success' : 'bg-danger');
const refresh = (): void => {
  updatingHealth.value = true;
  healthService
    .checkHealth()
    .then(res => {
      healthData.value = toHealthModel(res.data).indicators;
      updatingHealth.value = false;
    })
    .catch(error => {
      if (error.response?.status === 503) {
        healthData.value = toHealthModel(error.response.data).indicators;
      }
      updatingHealth.value = false;
    });
};
const showHealth = (health: HealthIndicator): void => {
  currentHealth.value = health;
  healthModal.value?.show();
};

onMounted(() => {
  refresh();
});

</script>
