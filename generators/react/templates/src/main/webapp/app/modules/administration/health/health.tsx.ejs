import { useEffect, useState } from 'react';
import { Badge, Button, Table } from 'react-bootstrap';
import { Translate } from 'react-jhipster';

import { faEye, faSync } from '@fortawesome/free-solid-svg-icons';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';

import { useAppDispatch, useAppSelector } from 'app/config/store';
import { type HealthIndicator } from 'app/shared/jhipster/health';
import { getSystemHealth } from '../administration.reducer';

import HealthModal from './health-modal';

export const HealthPage = () => {
  const [healthObject, setHealthObject] = useState<HealthIndicator>();
  const [showModal, setShowModal] = useState(false);
  const dispatch = useAppDispatch();

  const health = useAppSelector(state => state.administration.health);
  const isFetching = useAppSelector(state => state.administration.loading);

  useEffect(() => {
    dispatch(getSystemHealth());
  }, []);

  const fetchSystemHealth = () => {
    if (!isFetching) {
      dispatch(getSystemHealth());
    }
  };

  const getSystemHealthInfo = (indicator: HealthIndicator) => () => {
    setShowModal(true);
    setHealthObject(indicator);
  };

  const getBadgeType = (status: string) => (status === 'UP' ? 'success' : 'danger');

  const handleClose = () => setShowModal(false);

  const renderModal = () => <HealthModal healthObject={healthObject} handleClose={handleClose} showModal={showModal} />;

  const indicators: HealthIndicator[] = health?.indicators ?? [];

  return (
    <div>
      <h2>
        <span id="health-page-heading" data-cy="healthPageHeading">
          <Translate contentKey="health.title">Health Checks</Translate>
        </span>
        <Button onClick={fetchSystemHealth} variant="primary" className="float-end" disabled={isFetching}>
          <FontAwesomeIcon icon={faSync} />
          &nbsp;
          <Translate component="span" contentKey="health.refresh.button">
            Refresh
          </Translate>
        </Button>
      </h2>
      <Table responsive striped id="healthCheck" aria-describedby="health-page-heading">
        <thead>
          <tr>
            <th scope="col">
              <Translate contentKey="health.table.service">Service Name</Translate>
            </th>
            <th scope="col" className="text-center">
              <Translate contentKey="health.table.status">Status</Translate>
            </th>
            <th scope="col" className="text-center">
              <Translate contentKey="health.details.details">Details</Translate>
            </th>
          </tr>
        </thead>
        <tbody>
          {indicators.map(indicator => (
            <tr key={indicator.name}>
<%_ if (enableTranslation) { _%>
              <td>
                <Translate contentKey={`health.indicator.${indicator.baseName}`}>{indicator.baseName}</Translate>
                {indicator.subSystemName}
              </td>
<%_ } else { _%>
              <td>
                <span className="text-capitalize">{indicator.baseName}</span>
                {indicator.subSystemName}
              </td>
<%_ } _%>
              <td className="text-center">
                <Badge bg={getBadgeType(indicator.status)}>{indicator.status}</Badge>
              </td>
              <td className="text-center">
                {(indicator.details || indicator.error) && (
                  <a className="hand" onClick={getSystemHealthInfo(indicator)}>
                    <FontAwesomeIcon icon={faEye} />
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </Table>
      {renderModal()}
    </div>
  );
};

export default HealthPage;
