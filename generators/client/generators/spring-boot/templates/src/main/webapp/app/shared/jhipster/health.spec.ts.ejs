import { describe, expect, it } from 'vitest';

import { toHealthModel } from './health';

describe('health', () => {
  describe('toHealthModel', () => {
    it('should keep the status of a response without components', () => {
      expect(toHealthModel({ status: 'UP' })).toEqual({ status: 'UP', indicators: [] });
    });

    it('should convert a component with its details', () => {
      const { indicators } = toHealthModel({
        status: 'UP',
        components: { db: { status: 'UP', details: { database: 'H2', valid: true, nested: { a: 1 } } } },
      });

      expect(indicators).toEqual([
        {
          name: 'db',
          baseName: 'db',
          subSystemName: '',
          status: 'UP',
          details: { database: 'H2', valid: 'true', nested: '{"a":1}' },
        },
      ]);
    });

    it('should leave out the details of a component without them', () => {
      const { indicators } = toHealthModel({ status: 'UP', components: { ping: { status: 'UP' } } });

      expect(indicators).toEqual([{ name: 'ping', baseName: 'ping', subSystemName: '', status: 'UP' }]);
    });

    it('should separate the error from the details', () => {
      const { indicators } = toHealthModel({
        status: 'DOWN',
        components: {
          mail: { status: 'DOWN', details: { error: 'failed' } },
          db: { status: 'DOWN', details: { error: 'lost', database: 'H2' } },
        },
      });

      expect(indicators).toEqual([
        expect.objectContaining({ name: 'mail', error: 'failed' }),
        expect.objectContaining({ name: 'db', error: 'lost', details: { database: 'H2' } }),
      ]);
      expect(indicators[0].details).toBeUndefined();
    });

    it('should flatten the sub-components leaving out a parent with nothing to tell', () => {
      const { indicators } = toHealthModel({
        status: 'UP',
        components: {
          db: { status: 'UP', components: { primary: { status: 'UP' }, replica: { status: 'UP', components: { one: { status: 'UP' } } } } },
        },
      });

      expect(indicators.map(({ name, baseName, subSystemName }) => [name, baseName, subSystemName])).toEqual([
        ['db.primary', 'db', ' - primary'],
        ['db.replica.one', 'db', ' - replica.one'],
      ]);
    });

    it('should keep a parent that has details or an error', () => {
      const { indicators } = toHealthModel({
        status: 'DOWN',
        components: {
          db: { status: 'UP', details: { database: 'H2' }, components: { primary: { status: 'UP' } } },
          mail: { status: 'DOWN', details: { error: 'failed' }, components: { smtp: { status: 'DOWN' } } },
        },
      });

      expect(indicators.map(({ name }) => name)).toEqual(['db', 'db.primary', 'mail', 'mail.smtp']);
    });

    it('should show the numbers of the disk space in a human-readable unit', () => {
      const { indicators } = toHealthModel({
        status: 'UP',
        components: {
          diskSpace: { status: 'UP', details: { total: 2147483648, free: 214748, path: '/data', exists: true } },
        },
      });

      expect(indicators[0].details).toEqual({ total: '2.00 GB', free: '0.20 MB', path: '/data', exists: 'true' });
    });

    it('should show the numbers of a sub-component of the disk space in a human-readable unit', () => {
      const { indicators } = toHealthModel({
        status: 'UP',
        components: { diskSpace: { status: 'UP', components: { data: { status: 'UP', details: { total: 1073741824 } } } } },
      });

      expect(indicators[0].details).toEqual({ total: '1024.00 MB' });
    });

    it('should show the numbers of any other component as they came', () => {
      const { indicators } = toHealthModel({ status: 'UP', components: { custom: { status: 'UP', details: { total: 2147483648 } } } });

      expect(indicators[0].details).toEqual({ total: '2147483648' });
    });
  });
});
